rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth()       { return request.auth != null; }
    function uid()          { return request.auth.uid; }
    function userRole()     { return get(/databases/$(database)/documents/users/$(uid())).data.role; }
    function isSuperAdmin() { return userRole() == 'super_admin'; }
    function isAdmin()      { return userRole() in ['super_admin', 'admin']; }
    function isStaff()      { return userRole() in ['super_admin', 'admin', 'staff', 'recruitment_officer', 'editor']; }
    function isMember()     { return userRole() in ['super_admin', 'admin', 'staff', 'recruitment_officer', 'editor', 'cadet', 'parent']; }
    function isOwner(userId){ return uid() == userId; }

    match /system/{doc}       { allow read: if true; allow write: if isSuperAdmin(); }
    match /settings/{doc}     { allow read: if true; allow write: if isAdmin(); }
    match /roles/{roleId}     { allow read: if isAuth(); allow write: if isAdmin(); }
    match /posts/{postId}     { allow read: if true; allow write: if isStaff(); }
    match /applications/{id}  { allow read: if isStaff(); allow create: if true; allow update: if isStaff(); allow delete: if isAdmin(); }
    match /merchandise/{id}   { allow read: if isAuth() && isMember(); allow write: if isStaff(); }
    match /suggestions/{id}   { allow create: if true; allow read, update, delete: if isStaff(); }
    match /user_updates/{id}  { allow read: if isStaff(); allow create: if isAuth(); allow delete: if isAdmin(); }
    match /secure_settings/{doc} { allow read, write: if isSuperAdmin(); }
    match /merch_requests/{id} {
      allow read: if isAuth() && (resource.data.userUid == uid() || isStaff());
      allow create: if isAuth() && isMember();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }
    match /users/{userId} {
      allow read:   if isAuth() && (isOwner(userId) || isStaff());
      allow create: if isAuth() && isOwner(userId);
      allow update: if isAuth() && (isOwner(userId) || isStaff());
      allow delete: if isAdmin();
      match /notifications/{notifId} {
        allow read, write, delete: if isAuth() && isOwner(userId);
        allow create: if isStaff();
      }
    }
  }
}
