rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function myRole() {
      return isSignedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'visitor';
    }
    function isStaff() {
      return myRole() in ['super_admin','admin','staff','recruitment_officer','editor'];
    }
    function isAdmin() { return myRole() in ['super_admin','admin']; }
    function isSuperAdmin() { return myRole() == 'super_admin'; }
    function hasPermission(perm) {
      let roleDoc = get(/databases/$(database)/documents/roles/$(myRole()));
      return roleDoc.exists && roleDoc.data.permissions[perm] == true;
    }
    // Role hierarchy: lower rank number = more senior. Super Admin is
    // always rank 0. A role missing from the hierarchy map is treated as
    // the least senior possible (9999) so it can never accidentally
    // outrank someone.
    function hierarchyRanks() {
      let h = get(/databases/$(database)/documents/settings/roleHierarchy);
      return h.exists ? h.data.ranks : {
        'super_admin':0,'admin':1,'staff':2,'recruitment_officer':3,'editor':4,
        'cadet':5,'parent':6,'pending_cadet':7,'pending_parent':8
      };
    }
    function rankOf(role) {
      let ranks = hierarchyRanks();
      return role in ranks ? ranks[role] : 9999;
    }
    // The more senior (lower-numbered) of a user's current role and their
    // prospective new role, so nobody can dodge the check by requesting a
    // role change in the same write that touches a protected user.
    function targetRank() {
      let cur = rankOf(resource.data.role);
      let next = (request.resource != null && 'role' in request.resource.data) ? rankOf(request.resource.data.role) : cur;
      return cur < next ? cur : next;
    }
    // You can only manage (edit role, ban, delete) a user ranked strictly
    // BELOW you -- never a peer, never someone above you. Super Admin is
    // given a narrow bypass so a stale/missing manageUsers flag can never
    // lock the top tier out of managing ordinary members -- but even
    // Super Admin cannot touch rank 0 (another Super Admin).
    function canManageThisUser() {
      return isSuperAdmin() ? targetRank() > 0 : (hasPermission('manageUsers') && rankOf(myRole()) < targetRank());
    }

    // Users
    match /users/{uid} {
      allow read: if isOwner(uid) || isStaff() ||
        (isSignedIn() && resource.data.role in
          ['super_admin','admin','staff','recruitment_officer','editor']);
      allow create: if isOwner(uid);
      // A banned user can't modify their own doc (e.g. un-banning
      // themselves) -- staff with manageUsers can, subject to the
      // protected-account check above.
      allow update: if (isOwner(uid) && resource.data.banned!=true) || canManageThisUser();
      allow delete: if canManageThisUser();

      match /notifications/{notifId} {
        allow read, update, delete: if isOwner(uid) || isStaff();
        allow create: if isSignedIn();
      }
    }

    // Roles
    match /roles/{roleId} {
      allow read: if true;
      allow write: if isSuperAdmin() || (isStaff() && (hasPermission('manageRoles') || hasPermission('manageHierarchy')));
    }

    // System config
    match /system/{docId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin();
    }

    // Posts
    match /posts/{postId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Applications
    match /applications/{appId} {
      allow read: if isStaff();
      allow create: if true;
      allow update, delete: if isStaff();
    }

    // Merchandise
    match /merchandise/{itemId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Public Merchandise
    match /public_merchandise/{itemId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Merch requests / orders
    // All staff can read, create, update status fields
    // Only manageOrders permission can hard-delete (empty trash)
    match /merch_requests/{reqId} {
      allow read: if isStaff() ||
        (isSignedIn() && resource.data.userUid == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isStaff();
      allow delete: if isSignedIn() && hasPermission('manageOrders');
    }

    // Public orders
    match /public_orders/{reqId} {
      allow read: if isStaff();
      allow create: if true; // Public customers can submit orders
      allow update: if isStaff();
      allow delete: if isStaff() && hasPermission('manageOrders');
    }

    // Suggestions
    match /suggestions/{sugId} {
      allow read: if isStaff();
      allow create: if true;
      allow update, delete: if isStaff();
    }

    // Activity log
    match /user_updates/{updateId} {
      allow read: if isStaff();
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin();
    }

    // Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin()
        || (settingId=='permissionSlipTemplate' && hasPermission('printPermissionSlips'))
        || (settingId=='roleHierarchy' && hasPermission('manageHierarchy'));
    }

    // Secure settings
    match /secure_settings/{docId} {
      allow read, write: if isSuperAdmin();
    }

    // Conversations
    match /conversations/{convId} {
      allow read, update: if isSignedIn() &&
        (request.auth.uid in resource.data.participants || isStaff());
      allow create: if isSignedIn();
      allow delete: if isAdmin();

      match /messages/{msgId} {
        allow read: if isSignedIn() &&
          (request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(convId)).data.participants
            || isStaff());
        allow create: if isSignedIn() &&
          (request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(convId)).data.participants
            || isStaff());
        allow update: if isSignedIn() &&
          (request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(convId)).data.participants
            || isStaff());
        allow delete: if isSignedIn() &&
          (resource.data.senderId==request.auth.uid || isStaff());
      }
    }

    // Broadcasts
    match /broadcasts/{bcastId} {
      allow read: if isSignedIn();
      allow create: if isStaff();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Permission Slips -- the finalized slip (form data + signature) saved
    // per event, so members can view/download it from the Events page.
    match /permissionSlips/{postId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isStaff() && hasPermission('printPermissionSlips'));
    }
  }
}
