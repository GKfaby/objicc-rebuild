rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function myRole() {
      return isSignedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'visitor';
    }
    function isStaff() {
      return myRole() in ['super_admin','admin','staff','recruitment_officer','editor'];
    }
    function isAdmin() {
      return myRole() in ['super_admin','admin'];
    }
    function isSuperAdmin() {
      return myRole() == 'super_admin';
    }

    // Users
    match /users/{uid} {
      allow read: if isOwner(uid) || isStaff();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isStaff();
      allow delete: if isAdmin();

      match /notifications/{notifId} {
        allow read, update, delete: if isOwner(uid);
        allow create: if isSignedIn();
      }
    }

    // Roles & permissions
    match /roles/{roleId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // System config (first-user flag)
    match /system/{docId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin();
    }

    // Posts (notices & events)
    match /posts/{postId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Applications (enrollment)
    match /applications/{appId} {
      allow read: if isStaff();
      allow create: if true;
      allow update, delete: if isStaff();
    }

    // Merchandise
    match /merchandise/{itemId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Merch requests / orders
    match /merch_requests/{reqId} {
      allow read: if isStaff() || (isSignedIn() && resource.data.userUid == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isStaff();
    }

    // Suggestions
    match /suggestions/{sugId} {
      allow read: if isStaff();
      allow create: if true;
      allow update, delete: if isStaff();
    }

    // Activity log
    match /user_updates/{updateId} {
      allow read: if isStaff();
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin();
    }

    // Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Secure settings (payment keys etc.)
    match /secure_settings/{docId} {
      allow read, write: if isSuperAdmin();
    }

    // Conversations (member <-> admin messaging)
    match /conversations/{convId} {
      allow read, update: if isSignedIn() &&
        (request.auth.uid in resource.data.participants || isStaff());
      allow create: if isSignedIn();
      allow delete: if isAdmin();

      match /messages/{msgId} {
        allow read: if isSignedIn() &&
          (request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants || isStaff());
        allow create: if isSignedIn() &&
          (request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants || isStaff());
        allow update: if isSignedIn();
        allow delete: if isAdmin();
      }
    }

    // Broadcasts (admin -> roles)
    match /broadcasts/{bcastId} {
      allow read: if isSignedIn();
      allow create: if isStaff();
      allow update: if isSignedIn(); // allow readBy array updates
      allow delete: if isAdmin();
    }
  }
}
