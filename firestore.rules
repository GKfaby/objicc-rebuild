rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function myRole() {
      return isSignedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'visitor';
    }
    function isStaff() {
      return myRole() in ['super_admin','admin','staff','recruitment_officer','editor'];
    }
    function isAdmin() { return myRole() in ['super_admin','admin']; }
    function isSuperAdmin() { return myRole() == 'super_admin'; }
    function hasPermission(perm) {
      let roleDoc = get(/databases/$(database)/documents/roles/$(myRole()));
      return roleDoc.exists && roleDoc.data.permissions[perm] == true;
    }
    // A "protected" account (Super Admin / Admin) can only be touched --
    // deleted, banned, or have its role changed -- by an admin-tier user,
    // or by a role explicitly granted manageProtectedUsers. This also
    // blocks promoting a non-protected user INTO a protected role, not
    // just editing an already-protected one.
    function targetIsOrBecomesProtected() {
      return resource.data.role in ['super_admin','admin'] ||
        (request.resource != null && request.resource.data.role in ['super_admin','admin']);
    }
    function canManageThisUser() {
      return isAdmin() || (hasPermission('manageUsers') && (!targetIsOrBecomesProtected() || hasPermission('manageProtectedUsers')));
    }

    // Users
    match /users/{uid} {
      allow read: if isOwner(uid) || isStaff() ||
        (isSignedIn() && resource.data.role in
          ['super_admin','admin','staff','recruitment_officer','editor']);
      allow create: if isOwner(uid);
      // A banned user can't modify their own doc (e.g. un-banning
      // themselves) -- staff with manageUsers can, subject to the
      // protected-account check above.
      allow update: if (isOwner(uid) && resource.data.banned!=true) || canManageThisUser();
      allow delete: if canManageThisUser();

      match /notifications/{notifId} {
        allow read, update, delete: if isOwner(uid) || isStaff();
        allow create: if isSignedIn();
      }
    }

    // Roles
    match /roles/{roleId} {
      allow read: if true;
      allow write: if isSuperAdmin() || (isStaff() && hasPermission('manageRoles'));
    }

    // System config
    match /system/{docId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin();
    }

    // Posts
    match /posts/{postId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Applications
    match /applications/{appId} {
      allow read: if isStaff();
      allow create: if true;
      allow update, delete: if isStaff();
    }

    // Merchandise
    match /merchandise/{itemId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Merch requests / orders
    // All staff can read, create, update status fields
    // Only manageOrders permission can hard-delete (empty trash)
    match /merch_requests/{reqId} {
      allow read: if isStaff() ||
        (isSignedIn() && resource.data.userUid == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isStaff();
      allow delete: if isSignedIn() && hasPermission('manageOrders');
    }

    // Suggestions
    match /suggestions/{sugId} {
      allow read: if isStaff();
      allow create: if true;
      allow update, delete: if isStaff();
    }

    // Activity log
    match /user_updates/{updateId} {
      allow read: if isStaff();
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin();
    }

    // Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() || (settingId=='permissionSlipTemplate' && hasPermission('printPermissionSlips'));
    }

    // Secure settings
    match /secure_settings/{docId} {
      allow read, write: if isSuperAdmin();
    }

    // Conversations
    match /conversations/{convId} {
      allow read, update: if isSignedIn() &&
        (request.auth.uid in resource.data.participants || isStaff());
      allow create: if isSignedIn();
      allow delete: if isAdmin();

      match /messages/{msgId} {
        allow read: if isSignedIn() &&
          (request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(convId)).data.participants
            || isStaff());
        allow create: if isSignedIn() &&
          (request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(convId)).data.participants
            || isStaff());
        allow update: if isSignedIn() &&
          (request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(convId)).data.participants
            || isStaff());
        allow delete: if isSignedIn() &&
          (resource.data.senderId==request.auth.uid || isStaff());
      }
    }

    // Broadcasts
    match /broadcasts/{bcastId} {
      allow read: if isSignedIn();
      allow create: if isStaff();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Permission Slips -- the finalized slip (form data + signature) saved
    // per event, so members can view/download it from the Events page.
    match /permissionSlips/{postId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isStaff() && hasPermission('printPermissionSlips'));
    }
  }
}
